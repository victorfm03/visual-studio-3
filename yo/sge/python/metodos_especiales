from functools import total_ordering

@total_ordering
class Cuadrado:
    def __init__(self,lado):
        self.lado = lado
    def __lt__(self,otro):
        return ((self.lado < otro.lado))
    def __eq__(self,otro):
        return self.lado==otro.lado
mi_cuadrado = Cuadrado(4)
tu_cuadrado = Cuadrado(5)
if mi_cuadrado > tu_cuadrado:
    print ("Mi cuadrado es mayor")
elif mi_cuadrado == tu_cuadrado:
    print ("Mi cuadrado es igual")
else: print("Mi cuadrado es menor")