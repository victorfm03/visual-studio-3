<odoo>
  <data>

    <record id="view_escenario_tree" model="ir.ui.view">
      <field name="name">escenario.tree</field>
      <field name="model">ofm.escenario</field>
      <field name="arch" type="xml">
        <tree string="escenarios">
            <field name="nombre"/>
            <field name="ubicacion"/>
            <field name="tipo"/>
            <field name="precio"/>
            <field name="fecha_compra"/>
            <field name="state"/>
        </tree>
      </field>
    </record>

    <record id="fiesta_escenarios_calendar_view" model="ir.ui.view">
    <field name="name">ofm.escenario.calendar</field>
    <field name="model">ofm.escenario</field>
    <field name="arch" type="xml">
      <calendar string="escenarios" mode="month" date_start ="fecha_compra">
        <field name="nombre" />
      </calendar>
    </field>
  </record>


    <record id="view_escenario_form" model="ir.ui.view">
      <field name="name">escenario.form</field>
      <field name="model">ofm.escenario</field>
      <field name="arch" type="xml">
        <form string="Actuaciones">
          <sheet>
            <notebook>

              <page string="Datos Generales">
                <group>
                  <field name="tipo"/>
                  <field name="precio" readonly="1"/>
                  <field name="actuacion_id"/>
                </group>
              </page>

              <page string="Información de Compra">
                <group>
                  <field name="nombre"/>
                  <field name="edad" readonly="1"/>
                  <field name="fecha_nacimiento"/>
                  <field name="fecha_compra"/>
                </group>
              </page>

            </notebook>
          </sheet>
        </form>
      </field>
    </record>


    <record id="entrada_list_action" model="ir.actions.act_window">
      <field name="name">Entradas</field>
      <field name="res_model">ofm.entrada</field>
      <field name="view_mode">tree,form,calendar</field>
      <field name="view_id" ref="view_entrada_tree"/>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">Crea una entrada</p>
      </field>
    </record>

  </data>
</odoo>
